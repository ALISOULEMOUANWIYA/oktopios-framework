// =====================================================================
//  oktopios-framework — Routing & Contrôleurs
//  S'appuie sur le namespace natif `Server` (oktopios >= 0.12.0).
//  Chargé via :  use "oktopios_framework/routing.okp"
//
//  - Router  : enregistrement fluide de routes + démarrage du serveur
//  - Response: fabrique de réponses (texte / html / json / statut),
//              évite l'ambiguïté `return { ... }` du langage
//
//  Un contrôleur est une fonction (ou méthode) qui reçoit la requête
//  { method, path, query, params, body } et renvoie :
//    - une chaîne           -> 200 text/html
//    - res.json(x)          -> 200 application/json
//    - res.status(c, body)  -> code c
// =====================================================================
inject Server
inject Log
inject Type
inject Map
inject Environnement

// Un middleware « avant »  : fun(req) -> réponse | null   (null = continuer)
// Un middleware « après »  : fun(req, resp) -> resp        (transforme la réponse)
class Router {
    var mws: any      // pipeline avant
    var afters: any   // pipeline après

    fun __construct() {
        this.mws = []
        this.afters = []
    }

    // Ajoute un middleware « avant » (peut court-circuiter en renvoyant une réponse)
    fun use(mw: any): Router {
        this.mws = this.mws + [mw]
        return this
    }
    // Ajoute un middleware « après » (reçoit la réponse et la renvoie, éventuellement modifiée)
    fun after(mw: any): Router {
        this.afters = this.afters + [mw]
        return this
    }

    // Exécute le pipeline pour une requête : avant -> contrôleur -> après
    fun dispatch(handler: any, req: any): any {
        for (mw in this.mws) {
            var court = mw(req)
            if (court != null) { return court }
        }
        var resp = handler(req)
        for (amw in this.afters) {
            var nouveau = amw(req, resp)   // temp : `resp = amw(...)` direct non supporté
            resp = nouveau
        }
        return resp
    }

    fun get(path: string, handler: any): Router {
        var self = this
        Server.get(path, lambda(req: any) => self.dispatch(handler, req))
        return this
    }
    fun post(path: string, handler: any): Router {
        var self = this
        Server.post(path, lambda(req: any) => self.dispatch(handler, req))
        return this
    }
    fun put(path: string, handler: any): Router {
        var self = this
        Server.put(path, lambda(req: any) => self.dispatch(handler, req))
        return this
    }
    fun delete(path: string, handler: any): Router {
        var self = this
        Server.delete(path, lambda(req: any) => self.dispatch(handler, req))
        return this
    }
    // Démarre le serveur (bloquant). `port` accepte un entier ou une chaîne.
    // L'hôte d'écoute vient de OKTOPIOS_HOST (défaut 127.0.0.1) — mettre
    // 0.0.0.0 en conteneur pour être joignable de l'extérieur.
    fun run(port: any) {
        var host = Environnement.getenv("OKTOPIOS_HOST")
        if (host == null) { host = "127.0.0.1" }
        Server.run(port, host)
    }
    fun routes(): any {
        return Server.routes()
    }
}

class Response {
    // JSON (sérialisé par le serveur natif)
    fun json(data: any): any {
        var r = { "json": data }
        return r
    }
    // Texte brut (200)
    fun text(s: string): any {
        var r = { "body": s }
        return r
    }
    // HTML explicite
    fun html(s: string): any {
        var entetes = { "Content-Type": "text/html; charset=utf-8" }
        var r = { "body": s, "headers": entetes }
        return r
    }
    // Statut personnalisé
    fun status(code: int, body: string): any {
        var r = { "status": code, "body": body }
        return r
    }
    // Redirection
    fun redirect(url: string): any {
        var entetes = { "Location": url }
        var r = { "status": 302, "headers": entetes, "body": "" }
        return r
    }
}


// --- Middlewares prêts à l'emploi ---

// « avant » : journalise chaque requête (méthode + chemin), puis continue.
fun logRequest(req: any): any {
    Log.info(req["method"] + " " + req["path"])
    return null
}

// « après » : ajoute l'en-tête CORS (origine *) à la réponse.
fun corsAllowAll(req: any, resp: any): any {
    if (Type.isString(resp) == true) {
        var entetes = { "Access-Control-Allow-Origin": "*" }
        var wrap = { "body": resp, "headers": entetes }
        return wrap
    }
    var h = resp["headers"]
    if (h == null) { h = {} }
    var h2 = Map.set(h, "Access-Control-Allow-Origin", "*")
    var r2 = Map.set(resp, "headers", h2)
    return r2
}
